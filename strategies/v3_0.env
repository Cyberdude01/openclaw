# ─── V3.0 Dev Strategy ────────────────────────────────────────────────────────
# All triggers active — comprehensive strategy covering all market conditions.
# Only the legacy unsplit "forced" trigger tag is suppressed.
#
# Active triggers:
#   pre_open, forced_coin, forced_edge, arb,
#   directional_60pct, directional_80pct, directional_90pct (all buckets),
#   trend_follow (all applicable buckets)
#
# Reports: trigger_summary_v4.md  — expect forced_coin, forced_edge,
#          trend_follow, directional_90pct, pre_open visible per market
# ─────────────────────────────────────────────────────────────────────────────

STRATEGY_VERSION=v3

# ── Auto-restart ──────────────────────────────────────────────────────────────
AUTO_RESTART_HOURS=1

# ── Export / GitHub ───────────────────────────────────────────────────────────
# GITHUB_TOKEN=<your-token>
# EXPORT_REPO=https://github.com/Cyberdude01/Bob.git
# EXPORT_DIR=/root/bob
EXPORT_INTERVAL=300

# ── Database ──────────────────────────────────────────────────────────────────
DB_PATH=/root/polymarket_v3.db
DB_RETENTION_HOURS=36

# ── Polymarket Credentials (live trading) ─────────────────────────────────────
# POLY_PRIVATE_KEY=0x...
# POLY_ADDRESS=0x...
# POLY_API_KEY=...
# POLY_API_SECRET=...
# POLY_API_PASSPHRASE=...
