# ─── V2.0 Dev Strategy ────────────────────────────────────────────────────────
# Trend/Directional focus — tests whether trend_follow and directional_90pct
# are the primary profit drivers by suppressing forced_coin + forced_edge.
#
# Active triggers:
#   pre_open, arb, directional_90pct (HighVol), trend_follow (HighVol+Trend)
#
# Suppressed (vs V1):  forced_coin (all buckets), forced_edge (all buckets)
#
# Reports: trigger_summary_v3.md  — expect NO forced_coin / forced_edge rows
# ─────────────────────────────────────────────────────────────────────────────

STRATEGY_VERSION=v2

# ── Auto-restart ──────────────────────────────────────────────────────────────
AUTO_RESTART_HOURS=1

# ── Export / GitHub ───────────────────────────────────────────────────────────
# GITHUB_TOKEN=<your-token>
# EXPORT_REPO=https://github.com/Cyberdude01/Bob.git
# EXPORT_DIR=/root/bob
EXPORT_INTERVAL=300

# ── Database ──────────────────────────────────────────────────────────────────
DB_PATH=/root/polymarket_v2.db
DB_RETENTION_HOURS=36

# ── Polymarket Credentials (live trading) ─────────────────────────────────────
# POLY_PRIVATE_KEY=0x...
# POLY_ADDRESS=0x...
# POLY_API_KEY=...
# POLY_API_SECRET=...
# POLY_API_PASSPHRASE=...
