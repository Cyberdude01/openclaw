# ─── V1.0 Production Strategy ─────────────────────────────────────────────────
# Ring-fenced baseline strategy.
#
# Active triggers:
#   pre_open, forced_coin, forced_edge (HighVol+Trend/Range + LowVol only),
#   arb, directional_90pct (HighVol only), trend_follow (HighVol+Trend)
#
# To deploy: copy this file to /etc/polymarket.env (or merge with existing),
# then restart: sudo systemctl restart polymarket
# ─────────────────────────────────────────────────────────────────────────────

STRATEGY_VERSION=v1

# ── Auto-restart (recommended: 1 hour) ───────────────────────────────────────
AUTO_RESTART_HOURS=1

# ── Export / GitHub ───────────────────────────────────────────────────────────
# GITHUB_TOKEN=<your-token>
# EXPORT_REPO=https://github.com/Cyberdude01/Bob.git
# EXPORT_DIR=/root/bob
EXPORT_INTERVAL=300

# ── Database ──────────────────────────────────────────────────────────────────
DB_PATH=/root/polymarket.db
DB_RETENTION_HOURS=36

# ── Polymarket Credentials (live trading) ─────────────────────────────────────
# POLY_PRIVATE_KEY=0x...
# POLY_ADDRESS=0x...
# POLY_API_KEY=...
# POLY_API_SECRET=...
# POLY_API_PASSPHRASE=...
